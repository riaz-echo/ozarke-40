<div class="custom-cta-banner full-width">
  <div class="custom-cta-banner__image">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy' }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
    <div class="custom-cta-banner__overlay" style="opacity: {{ section.settings.overlay_opacity }}%;"></div>
  </div>

  <div class="custom-cta-banner__content">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.description }}</p>
    {% render 'custom-button', label: section.settings.button_label, url: section.settings.button_link, style: 'light' %}
  </div>
</div>

{% stylesheet %}
  .custom-cta-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 567px;
    padding: 80px 40px;
    overflow: hidden;
    background: #1a1a1a;
    color: #fff;
    font-family: var(--font-primary--family);
    text-align: center;
  }

  .custom-cta-banner__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .custom-cta-banner__image img,
  .custom-cta-banner__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-cta-banner__image svg {
    fill: rgba(255, 255, 255, 0.15);
  }

  .custom-cta-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000;
  }

  .custom-cta-banner__content {
    position: relative;
    max-width: 680px;
  }

  .custom-cta-banner__content h2 {
    margin: 0;
    font-size: 48px;
    font-weight: 400;
    line-height: 53px;
  }

  .custom-cta-banner__content p {
    margin: 16px 0 36px;
    font-size: 15px;
    line-height: 1.6;
  }

  .custom-cta-banner .custom-button {
    width: 409px;
  }

  @media (max-width: 749px) {
    .custom-cta-banner {
      min-height: 282px;
      padding: 60px 16px;
    }

    .custom-cta-banner__content h2 {
      font-size: 32px;
      line-height: 32px;
    }

    .custom-cta-banner__content p {
      margin: 12px 0 32px;
      font-size: 14px;
      line-height: 1.5;
    }

    .custom-cta-banner .custom-button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_cta_banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Ready to start?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Apply for trade pricing today — no minimum order, no long forms."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Apply for Trade Pricing"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_cta_banner"
    }
  ]
}
{% endschema %}
