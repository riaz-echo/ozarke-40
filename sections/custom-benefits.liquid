<div class="custom-benefits full-width">
  <div class="custom-benefits__inner">
    <div class="custom-benefits__header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.description }}</p>
    </div>

    <div class="custom-benefits__grid">
      {% for block in section.blocks %}
        <div class="custom-benefits__card" {{ block.shopify_attributes }}>
          <span class="custom-benefits__icon">
            {% case block.settings.icon %}
              {% when 'tag' %}
                {{ 'icon-line-tag.svg' | inline_asset_content }}
              {% when 'user' %}
                {{ 'icon-line-user.svg' | inline_asset_content }}
              {% when 'truck' %}
                {{ 'icon-line-truck.svg' | inline_asset_content }}
              {% when 'clock' %}
                {{ 'icon-line-clock.svg' | inline_asset_content }}
              {% when 'star' %}
                {{ 'icon-line-star.svg' | inline_asset_content }}
              {% when 'percent' %}
                {{ 'icon-line-percent.svg' | inline_asset_content }}
            {% endcase %}
          </span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>

    <div class="custom-benefits__button">
      {% render 'custom-button', label: section.settings.button_label, url: section.settings.button_link %}
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-benefits {
    margin-top: 120px;
    padding: 0 80px;
    background: #f1f1f1;
    color: #1a1a1a;
    font-family: var(--font-primary--family);
  }

  .custom-benefits__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .custom-benefits__header {
    margin-bottom: 64px;
    text-align: center;
  }

  .custom-benefits__header h2 {
    margin: 0 0 12px;
    font-size: 40px;
    font-weight: 400;
    line-height: 46px;
  }

  .custom-benefits__header p {
    max-width: 946px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.2;
    opacity: 0.8;
  }

  .custom-benefits__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .custom-benefits__card {
    padding: 28px;
    background: #fff;
  }

  .custom-benefits__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(61, 18, 245, 0.05);
  }

  .custom-benefits__icon svg {
    width: 24px;
    height: 24px;
  }

  .custom-benefits__card h3 {
    margin: 16px 0;
    font-size: 18px;
    font-weight: 400;
    line-height: 18px;
  }

  .custom-benefits__card p {
    margin: 0;
    color: #484848;
    font-size: 12px;
    line-height: 1.5;
  }

  .custom-benefits__button {
    margin-top: 60px;
    text-align: center;
  }

  @media (max-width: 989px) {
    .custom-benefits {
      padding: 0 40px;
    }
  }

  @media (max-width: 749px) {
    .custom-benefits {
      margin-top: 0;
      padding: 48px 24px;
    }

    .custom-benefits__header {
      margin-bottom: 32px;
      text-align: left;
    }

    .custom-benefits__header h2 {
      font-size: 28px;
      line-height: 28px;
    }

    .custom-benefits__header p {
      color: #484848;
      font-size: 13px;
      line-height: 1.4;
      opacity: 1;
    }

    .custom-benefits__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .custom-benefits__card {
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04), 0 18px 40px rgba(0, 0, 0, 0.06);
    }

    .custom-benefits__icon {
      width: 40px;
      height: 40px;
    }

    .custom-benefits__icon svg {
      width: 20px;
      height: 20px;
    }

    .custom-benefits__card h3 {
      margin: 12px 0;
      font-size: 16px;
      line-height: 16px;
    }

    .custom-benefits__card p {
      font-size: 13px;
      line-height: 1.4;
    }

    .custom-benefits__button {
      margin-top: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "More Than Just Pricing"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "We understand your timelines and client pressures. Our benefits ensure you have a seamless experience from planning to installation."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Apply for Trade Pricing"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:general.benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "tag", "label": "t:options.icon.tag" },
            { "value": "user", "label": "t:options.icon.user" },
            { "value": "truck", "label": "t:options.icon.truck" },
            { "value": "clock", "label": "t:options.icon.clock" },
            { "value": "star", "label": "t:options.icon.star" },
            { "value": "percent", "label": "t:options.icon.percent" }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Exclusive trade pricing"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text",
          "default": "Up to 35% discount based on tier structure, applied directly at checkout online or via quote."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "tag",
            "title": "Exclusive trade pricing",
            "text": "Up to 35% discount based on tier structure, applied directly at checkout online or via quote."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "user",
            "title": "A named contact",
            "text": "Personalized service with direct phone and email access to resolve custom specifications."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "title": "Free shipping",
            "text": "No delivery charges on standard orders. Coordinated shipping of bulk orders."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "clock",
            "title": "Priority processing",
            "text": "Your orders enter production and shipping queue with elevated priority to meet install targets."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "star",
            "title": "Early access",
            "text": "Preview and order from new seasonal collections before they launch to the general public."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "percent",
            "title": "Zero sales tax",
            "text": "Seamless VAT/sales tax exemption integration for eligible companies and physical stores."
          }
        }
      ]
    }
  ]
}
{% endschema %}
