<div class="custom-tiers full-width">
  <div class="custom-tiers__inner">
    <div class="custom-tiers__header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.description }}</p>
    </div>

    <div class="custom-tiers__grid">
      {% for block in section.blocks %}
        <div class="custom-tiers__card{% if block.settings.highlight %} is-highlighted{% endif %}" {{ block.shopify_attributes }}>
          <div class="custom-tiers__top">
            <div>
              <h3>{{ block.settings.name }}</h3>
              <p class="custom-tiers__discount">{{ block.settings.discount }}</p>
              <p class="custom-tiers__spend">{{ block.settings.spend }}</p>
            </div>

            {% if block.settings.highlight and block.settings.tag != blank %}
              <span class="custom-tiers__tag">{{ block.settings.tag }}</span>
            {% endif %}
          </div>

          <p class="custom-tiers__text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>

    <div class="custom-tiers__button">
      {% render 'custom-button', label: section.settings.button_label, url: section.settings.button_link %}
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-tiers {
    padding: 120px 80px;
    background: #f1f1f1;
    color: #1a1a1a;
    font-family: var(--font-primary--family);
  }

  .custom-tiers__inner {
    max-width: 1272px;
    margin: 0 auto;
  }

  .custom-tiers__header {
    max-width: 920px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .custom-tiers__header h2 {
    margin: 0 0 16px;
    font-size: 40px;
    font-weight: 400;
    line-height: 40px;
    letter-spacing: -0.8px;
  }

  .custom-tiers__header p {
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    opacity: 0.8;
  }

  .custom-tiers__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .custom-tiers__card {
    position: relative;
    padding: 32px;
    background: #fff;
  }

  .custom-tiers__card.is-highlighted {
    box-shadow: inset 0 6px 0 #3d12f5;
  }

  .custom-tiers__top {
    padding-bottom: 20px;
    margin-bottom: 20px;
    border-bottom: 1px solid #595959;
  }

  .custom-tiers__card h3 {
    margin: 0 0 12px;
    font-size: 36px;
    font-weight: 400;
    line-height: 36px;
  }

  .custom-tiers__discount {
    margin: 0 0 10px;
    font-size: 22px;
    line-height: 22px;
  }

  .custom-tiers__spend {
    margin: 0;
    color: #484848;
    font-size: 13px;
    opacity: 0.9;
  }

  .custom-tiers__tag {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 6px 10px;
    border-radius: 20px;
    background: #3d12f5;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    color: #fff;
    font-size: 11px;
    line-height: 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .custom-tiers__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.9;
  }

  .custom-tiers__button {
    margin-top: 60px;
    text-align: center;
  }

  @media (max-width: 989px) {
    .custom-tiers {
      padding: 80px 40px;
    }

    .custom-tiers__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 749px) {
    .custom-tiers {
      padding: 48px 24px;
      border-top: 1px solid #e5e7eb;
      border-bottom: 1px solid #e5e7eb;
    }

    .custom-tiers__header {
      margin-bottom: 32px;
      text-align: left;
    }

    .custom-tiers__header h2 {
      margin-bottom: 12px;
      font-size: 28px;
      line-height: 34px;
      letter-spacing: 0;
    }

    .custom-tiers__header p {
      font-size: 13px;
      line-height: 1.4;
    }

    .custom-tiers__grid {
      gap: 20px;
    }

    .custom-tiers__card {
      padding: 24px;
    }

    .custom-tiers__top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 16px;
      margin-bottom: 16px;
    }

    .custom-tiers__card h3 {
      font-size: 24px;
      line-height: 24px;
    }

    .custom-tiers__discount {
      margin-bottom: 12px;
      font-size: 18px;
      line-height: 18px;
    }

    .custom-tiers__spend {
      font-size: 12px;
      opacity: 1;
    }

    .custom-tiers__tag {
      position: static;
    }

    .custom-tiers__text {
      font-size: 12px;
      line-height: 1.5;
      opacity: 1;
    }

    .custom-tiers__button {
      margin-top: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_tiers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Designed to Support Your Growth"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Your trade benefits automatically expand as your annual portfolio spend increases. Transparent scaling, zero negotiations."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Apply for Trade Pricing"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "t:general.tier",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "t:labels.name",
          "default": "Bronze"
        },
        {
          "type": "text",
          "id": "discount",
          "label": "t:labels.discount",
          "default": "15% OFF"
        },
        {
          "type": "text",
          "id": "spend",
          "label": "t:labels.spend",
          "default": "Annual spend under £2,000"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text",
          "default": "Trade pricing across the full catalogue. Free shipping. Early access to new arrivals."
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "t:labels.highlight",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "t:labels.tag",
          "default": "Premium"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:general.custom_tiers",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "name": "Bronze",
            "discount": "15% OFF",
            "spend": "Annual spend under £2,000",
            "text": "Trade pricing across the full catalogue. Free shipping. Early access to new arrivals."
          }
        },
        {
          "type": "tier",
          "settings": {
            "name": "Silver",
            "discount": "25% OFF",
            "spend": "Annual spend £2,000-£5,000",
            "text": "Everything in Bronze, plus priority processing and discounted physical samples for clients."
          }
        },
        {
          "type": "tier",
          "settings": {
            "name": "Gold",
            "discount": "35% OFF",
            "spend": "Annual spend over £5,000",
            "text": "Everything in Silver, plus a named account manager, early access to limited editions, and concierge ordering support.",
            "highlight": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
