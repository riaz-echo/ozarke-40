<div class="custom-features full-width{% if section.settings.image_position == 'left' %} image-left{% endif %}">
  <div class="custom-features__content">
    <h2>{{ section.settings.heading }}</h2>

    <ul>
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {% endfor %}
    </ul>
  </div>

  <div class="custom-features__image">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy' }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .custom-features {
    display: flex;
    margin-top: 120px;
    background: #fff;
    color: #1a1a1a;
    font-family: var(--font-primary--family);
  }

  .custom-features.image-left {
    flex-direction: row-reverse;
  }

  .custom-features__content {
    width: 50.4%;
    padding: 80px 60px 80px 80px;
  }

  .custom-features__content h2 {
    margin: 0 0 32px;
    font-size: 40px;
    font-weight: 400;
    line-height: 44px;
    letter-spacing: -1px;
  }

  .custom-features__content ul {
    max-width: 566px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .custom-features__content li {
    position: relative;
    margin-bottom: 32px;
    padding-left: 42px;
  }

  .custom-features__content li:last-child {
    margin-bottom: 0;
  }

  /* Bullet: light purple circle with a dark dot in the middle */
  .custom-features__content li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 3px;
    width: 12px;
    height: 12px;
    border: 4px solid rgba(233, 228, 255, 0.7);
    border-radius: 50%;
    background: #1a1a1a;
    background-clip: padding-box;
  }

  .custom-features__content h3 {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 400;
    line-height: 14px;
    text-transform: uppercase;
  }

  .custom-features__content p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.7;
  }

  .custom-features__image {
    position: relative;
    width: 49.6%;
    background: #e7e7e7;
  }

  .custom-features__image img,
  .custom-features__image svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-features__image svg {
    fill: #c9c9c9;
  }

  @media (max-width: 989px) {
    .custom-features__content {
      padding: 64px 40px;
    }
  }

  @media (max-width: 749px) {
    .custom-features,
    .custom-features.image-left {
      flex-direction: column-reverse;
      margin-top: 0;
    }

    .custom-features__content,
    .custom-features__image {
      width: 100%;
    }

    .custom-features__image {
      height: 217px;
    }

    .custom-features__content {
      padding: 32px 24px;
    }

    .custom-features__content h2 {
      margin-bottom: 24px;
      font-size: 28px;
      line-height: 32px;
      letter-spacing: -0.5px;
    }

    .custom-features__content li {
      margin-bottom: 24px;
    }

    .custom-features__content h3 {
      line-height: 16px;
      letter-spacing: 0.5px;
      text-transform: none;
    }

    .custom-features__content p {
      font-size: 12px;
      line-height: 1.5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Make specifying easier"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "right", "label": "t:options.alignment.right" },
        { "value": "left", "label": "t:options.alignment.left" }
      ],
      "default": "right"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:general.feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "A wide lighting assortment"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text",
          "default": "Source statement pieces, architectural lighting, decorative fixtures, and complementary products within one destination."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "A wide lighting assortment",
            "text": "Source statement pieces, architectural lighting, decorative fixtures, and complementary products within one destination."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Solutions across project types",
            "text": "Lighting for residential, hospitality, commercial, and development projects."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Trade support when you need it",
            "text": "Get help with product questions, larger orders, availability, and purchasing."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Project-friendly purchasing",
            "text": "Trade pricing, free shipping, and eligible tax exemptions help simplify project budgets."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "One account. Ongoing access.",
            "text": "Once approved, professionals can return to Ozarké for future projects without reapplying."
          }
        }
      ]
    }
  ]
}
{% endschema %}
