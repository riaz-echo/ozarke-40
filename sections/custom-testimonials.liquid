        {
          "type": "text",
          "id": "name",
          "label": "t:labels.name",
          "default": "Alistair Vance"
        },
        {
          "type": "text",
          "id": "company",
          "label": "t:labels.company",
          "default": "Vance & Partners · London"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
