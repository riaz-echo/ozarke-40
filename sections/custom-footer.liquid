<footer class="custom-footer full-width">
  <a href="{{ routes.root_url }}" class="custom-footer__logo">
    {% if section.settings.logo %}
      {{ section.settings.logo | image_url: width: 2720 | image_tag: alt: shop.name, loading: 'lazy' }}
    {% else %}
      {{ 'ozarke-logo.svg' | inline_asset_content }}
    {% endif %}
  </a>

  <div class="custom-footer__main">
    <div class="custom-footer__left">
      <div class="custom-footer__newsletter">
        <p>{{ section.settings.newsletter_heading }}</p>

        {% form 'customer', class: 'custom-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="{{ 'custom_footer.email' | t }}" aria-label="{{ 'custom_footer.email' | t }}" required>
          <button type="submit">{{ 'custom_footer.sign_up' | t }}</button>

          {% if form.posted_successfully? %}
            <p class="custom-footer__message">{{ 'custom_footer.subscribed' | t }}</p>
          {% elsif form.errors %}
            <div class="custom-footer__message">{{ form.errors | default_errors }}</div>
          {% endif %}
        {% endform %}
      </div>

      <div class="custom-footer__apps">
        {% if section.settings.app_store_link != blank %}
          <a href="{{ section.settings.app_store_link }}" target="_blank">
            {{ 'icon-apple.svg' | inline_asset_content }}
            <span>
              <small>{{ 'custom_footer.app_store_small' | t }}</small>
              {{ 'custom_footer.app_store' | t }}
            </span>
          </a>
        {% endif %}
        {% if section.settings.google_play_link != blank %}
          <a href="{{ section.settings.google_play_link }}" target="_blank">
            {{ 'icon-google-play.svg' | inline_asset_content }}
            <span>
              <small>{{ 'custom_footer.google_play_small' | t }}</small>
              {{ 'custom_footer.google_play' | t }}
            </span>
          </a>
        {% endif %}
      </div>

      <div class="custom-footer__socials">
        {% if section.settings.social_facebook != blank %}
          <a href="{{ section.settings.social_facebook }}" target="_blank" aria-label="Facebook">{{ 'icon-facebook.svg' | inline_asset_content }}</a>
        {% endif %}
        {% if section.settings.social_instagram != blank %}
          <a href="{{ section.settings.social_instagram }}" target="_blank" aria-label="Instagram">{{ 'icon-instagram.svg' | inline_asset_content }}</a>
        {% endif %}
        {% if section.settings.social_pinterest != blank %}
          <a href="{{ section.settings.social_pinterest }}" target="_blank" aria-label="Pinterest">{{ 'icon-pinterest.svg' | inline_asset_content }}</a>
        {% endif %}
        {% if section.settings.social_tiktok != blank %}
          <a href="{{ section.settings.social_tiktok }}" target="_blank" aria-label="TikTok">{{ 'icon-tiktok.svg' | inline_asset_content }}</a>
        {% endif %}
        {% if section.settings.social_linkedin != blank %}
          <a href="{{ section.settings.social_linkedin }}" target="_blank" aria-label="LinkedIn">{{ 'icon-linkedin.svg' | inline_asset_content }}</a>
        {% endif %}
      </div>

      <div class="custom-footer__bottom">
        <p>{{ localization.country.name }} ({{ localization.country.currency.iso_code }}{{ localization.country.currency.symbol }})</p>

        <div class="custom-footer__legal">
          <p>&copy; {{ 'now' | date: '%Y' }} + {{ section.settings.copyright }}</p>
          {% for link in section.settings.menu_legal.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="custom-footer__menus">
      {% if section.settings.menu_main != blank %}
        <div class="custom-footer__menu custom-footer__menu--wide">
          <p class="custom-footer__menu-title">{{ section.settings.menu_main.title }}</p>
          <ul>
            {% for link in section.settings.menu_main.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if section.settings.menu_second != blank %}
        <div class="custom-footer__menu">
          <p class="custom-footer__menu-title">{{ section.settings.menu_second.title }}</p>
          <ul>
            {% for link in section.settings.menu_second.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if section.settings.menu_third != blank %}
        <div class="custom-footer__menu">
          <p class="custom-footer__menu-title">{{ section.settings.menu_third.title }}</p>
          <ul>
            {% for link in section.settings.menu_third.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .custom-footer {
    padding: 40px 40px 39px;
    background: #f1f1f1;
    color: #1a1a1a;
    font-family: var(--font-primary--family);
  }

  .custom-footer a {
    color: inherit;
    text-decoration: none;
  }

  .custom-footer p {
    margin: 0;
  }

  .custom-footer__logo {
    display: block;
    margin-bottom: 40px;
  }

  .custom-footer__logo svg,
  .custom-footer__logo img {
    width: 100%;
    height: auto;
  }

  .custom-footer__main {
    display: flex;
    justify-content: space-between;
    gap: 40px;
  }

  .custom-footer__left {
    display: flex;
    flex-direction: column;
    width: 560px;
  }

  /* Newsletter */
  .custom-footer__newsletter {
    margin-bottom: 68px;
    font-size: 14px;
  }

  .custom-footer__form {
    position: relative;
    margin-top: 4px;
  }

  .custom-footer__form input {
    width: 100%;
    height: 48px;
    padding: 5px 110px 10px 2px;
    border: 0;
    border-bottom: 4px solid #141414;
    border-radius: 0;
    background: transparent;
    color: #1a1a1a;
    font-family: inherit;
    font-size: 24px;
    letter-spacing: -0.48px;
    outline: none;
  }

  .custom-footer__form input::placeholder {
    color: #1a1a1a;
  }

  .custom-footer__form button {
    position: absolute;
    top: 4px;
    right: 0;
    height: 32px;
    padding: 0 11px 2px;
    border: 1px solid #1a1a1a;
    border-radius: 32px;
    background: transparent;
    color: #1a1a1a;
    font-family: inherit;
    font-size: 24px;
    letter-spacing: -0.48px;
    cursor: pointer;
  }

  .custom-footer__form button:hover {
    background: #1a1a1a;
    color: #f1f1f1;
  }

  .custom-footer .custom-footer__message {
    margin-top: 8px;
  }

  /* App badges */
  .custom-footer__apps a {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 140px;
    height: 40px;
    margin-bottom: 16px;
    padding: 0 12px;
    border: 1px solid #1a1a1a;
    border-radius: 24px;
    font-size: 16px;
    line-height: 16px;
    letter-spacing: -0.48px;
    white-space: nowrap;
  }

  .custom-footer__apps a:last-child {
    margin-bottom: 46px;
  }

  .custom-footer__apps svg {
    width: 20px;
    height: 24px;
  }

  .custom-footer__apps small {
    display: block;
    font-size: 9px;
    line-height: 9px;
  }

  /* Social icons */
  .custom-footer__socials {
    display: flex;
    align-items: center;
    gap: 21px;
    margin-bottom: 80px;
  }

  .custom-footer__socials svg {
    display: block;
    max-width: 24px;
    max-height: 25px;
  }

  .custom-footer__socials a:hover {
    opacity: 0.6;
  }

  /* Bottom row */
  .custom-footer__bottom {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    font-size: 14px;
  }

  .custom-footer__legal {
    width: 145px;
  }

  .custom-footer__legal p {
    margin-bottom: 24px;
  }

  .custom-footer__legal a {
    display: block;
    margin-bottom: 10px;
  }

  .custom-footer__legal a:hover,
  .custom-footer__menu a:hover {
    text-decoration: underline;
  }

  /* Menus */
  .custom-footer__menus {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 41px 14px;
    width: 672px;
    padding-top: 40px;
  }

  .custom-footer__menu {
    width: calc(50% - 7px);
  }

  .custom-footer__menu--wide {
    width: 100%;
  }

  .custom-footer .custom-footer__menu-title {
    margin-bottom: 20px;
    padding-bottom: 4px;
    border-bottom: 4px solid #1a1a1a;
    font-size: 15px;
    line-height: 25.5px;
  }

  .custom-footer__menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .custom-footer__menu li {
    border-bottom: 1px solid #1a1a1a;
  }

  .custom-footer__menu a {
    display: block;
    font-size: 14px;
    line-height: 24px;
  }

  @media (max-width: 989px) {
    .custom-footer__main {
      flex-direction: column-reverse;
      gap: 56px;
    }

    .custom-footer__left,
    .custom-footer__menus {
      width: 100%;
    }

    .custom-footer__menus {
      padding-top: 0;
    }
  }

  @media (max-width: 749px) {
    .custom-footer {
      padding: 24px 16px 32px;
    }

    .custom-footer__logo {
      margin-bottom: 24px;
    }

    .custom-footer__main {
      gap: 48px;
    }

    .custom-footer__menus {
      gap: 32px;
    }

    .custom-footer__menu {
      width: 100%;
    }

    .custom-footer__newsletter {
      margin-bottom: 40px;
    }

    .custom-footer__form input,
    .custom-footer__form button {
      font-size: 20px;
    }

    .custom-footer__apps {
      display: flex;
      gap: 12px;
      margin-bottom: 32px;
    }

    .custom-footer__apps a,
    .custom-footer__apps a:last-child {
      margin-bottom: 0;
    }

    .custom-footer__socials {
      margin-bottom: 40px;
    }

    .custom-footer__bottom {
      flex-direction: column;
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:labels.newsletter_heading",
      "default": "Sign up for updates"
    },
    {
      "type": "link_list",
      "id": "menu_main",
      "label": "t:labels.menu_main",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_second",
      "label": "t:labels.menu_second"
    },
    {
      "type": "link_list",
      "id": "menu_third",
      "label": "t:labels.menu_third"
    },
    {
      "type": "link_list",
      "id": "menu_legal",
      "label": "t:labels.menu_legal",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "t:labels.copyright",
      "default": "Ozarké LLC"
    },
    {
      "type": "header",
      "content": "t:general.apps"
    },
    {
      "type": "url",
      "id": "app_store_link",
      "label": "t:labels.app_store_link"
    },
    {
      "type": "url",
      "id": "google_play_link",
      "label": "t:labels.google_play_link"
    },
    {
      "type": "header",
      "content": "t:general.social_media"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "t:labels.facebook"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "t:labels.instagram"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "t:labels.pinterest"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "t:labels.tiktok"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "t:labels.linkedin"
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_footer"
    }
  ]
}
{% endschema %}
