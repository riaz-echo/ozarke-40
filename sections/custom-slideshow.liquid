<div
  class="custom-slideshow full-width"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
>
  {% for block in section.blocks %}
    <div class="custom-slideshow__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
      {% if block.settings.image %}
        {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy' }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {% endif %}

      <div class="custom-slideshow__overlay"></div>
      <p>{{ block.settings.text }}</p>
    </div>
  {% endfor %}

  {% if section.blocks.size > 1 %}
    <div class="custom-slideshow__dots">
      {% for block in section.blocks %}
        <button
          type="button"
          class="{% if forloop.first %}is-active{% endif %}"
          aria-label="{{ 'custom_slideshow.go_to_slide' | t: index: forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</div>

<style>
  #shopify-section-{{ section.id }} .custom-slideshow__overlay {
    opacity: {{ section.settings.overlay_opacity }}%;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .custom-slideshow__overlay {
      opacity: {{ section.settings.overlay_opacity_mobile }}%;
    }
  }
</style>

{% stylesheet %}
  .custom-slideshow {
    position: relative;
    height: 572px;
    overflow: hidden;
    background: #1a1a1a;
    color: #fff;
    font-family: var(--font-primary--family);
  }

  .custom-slideshow__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s;
  }

  .custom-slideshow__slide.is-active {
    opacity: 1;
  }

  .custom-slideshow__slide img,
  .custom-slideshow__slide svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-slideshow__slide svg {
    fill: rgba(255, 255, 255, 0.15);
  }

  .custom-slideshow__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000;
  }

  .custom-slideshow__slide p {
    position: absolute;
    left: 80px;
    bottom: 80px;
    max-width: 533px;
    margin: 0;
    font-size: 32px;
    line-height: 1.2;
  }

  .custom-slideshow__dots {
    position: absolute;
    left: 80px;
    bottom: 39px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .custom-slideshow__dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: rgba(239, 239, 239, 0.6);
    cursor: pointer;
    transition: width 0.3s;
  }

  .custom-slideshow__dots button.is-active {
    width: 33px;
    height: 9px;
    background: #fff;
  }

  @media (max-width: 989px) {
    .custom-slideshow__slide p,
    .custom-slideshow__dots {
      left: 40px;
    }
  }

  @media (max-width: 749px) {
    .custom-slideshow {
      height: 240px;
    }

    .custom-slideshow__slide p {
      left: 24px;
      right: 24px;
      bottom: 49px;
      font-size: 22px;
      line-height: 1.3;
    }

    .custom-slideshow__dots {
      left: 24px;
      bottom: 24px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.custom-slideshow').forEach(function (slideshow) {
    var slides = slideshow.querySelectorAll('.custom-slideshow__slide');
    var dots = slideshow.querySelectorAll('.custom-slideshow__dots button');
    var current = 0;
    var timer;

    function showSlide(index) {
      slides[current].classList.remove('is-active');
      dots[current].classList.remove('is-active');
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      dots[current].classList.add('is-active');
    }

    function startAutoplay() {
      if (slideshow.dataset.autoplay !== 'true' || slides.length < 2) return;
      clearInterval(timer);
      timer = setInterval(function () {
        showSlide(current + 1);
      }, slideshow.dataset.speed * 1000);
    }

    dots.forEach(function (dot, index) {
      dot.addEventListener('click', function () {
        showSlide(index);
        startAutoplay();
      });
    });

    slideshow.addEventListener('mouseenter', function () {
      clearInterval(timer);
    });
    slideshow.addEventListener('mouseleave', startAutoplay);

    startAutoplay();
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.custom_slideshow",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:labels.autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_opacity_mobile",
      "label": "t:labels.overlay_opacity_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text",
          "default": "Considered pieces, built for projects that need to last."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.custom_slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
